# Copie para .env e preencha. Não commit secrets.

# SQLite local canônico
DATABASE_URL="file:./prisma/dev.db"

# Auth APIs (opcional em local — há fallbacks de dev)
# ADMIN_API_SECRET=
# MAKER_API_SECRET=

# SMTP (D013) — vazio = modo console (código no log / API devCode)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="FabMakers <noreply@seudominio.com>"
