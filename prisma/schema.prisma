// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Modelagem Inicial do Ecossistema Multilateral FabMakers

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    // "CLIENT", "MAKER", "DESIGNER", "ADMIN"
  
  // Confirmação de E-mail
  emailVerified    Boolean   @default(false)
  verificationToken String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relações
  makerProfile  MakerProfile?
  designerProfile DesignerProfile?
  ordersAsClient Order[]  @relation("ClientOrders")
}

model MakerProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city           String
  state          String
  machines       String    // JSON string listando as impressoras e especificações
  materials      String    // JSON string listando cores e tipos de filamento (PLA, ABS, PETG)
  availability   String    @default("{}") // JSON string com calendário de disponibilidade (horas, dias, meses)
  rating         Float     @default(5.0)
  isApproved     Boolean   @default(false) // Homologação de qualidade
  penaltiesCount Int       @default(0)     // Contagem de penalidades acumuladas por desistência
  isBanned       Boolean   @default(false) // Flag de banimento automático em faltas graves
  
  // Onboarding Anti-Fraude e Contrato SLA
  contractAccepted Boolean   @default(false)
  kycStatus        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  makerStatus      String    @default("UNVERIFIED") // UNVERIFIED, PENDING_APPROVAL, SANDBOX, HOMOLOGATED, BANNED
  kycDocumentUrl   String?
  kycSelfieUrl     String?
  
  // Medições físicas da Calibração técnica
  calibX           Float?
  calibY           Float?
  calibZ           Float?
  calibImageUrl    String?
  
  ordersAsMaker  Order[]   @relation("MakerOrders")
}

model DesignerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paypalEmail   String?
  rating        Float     @default(5.0)
  
  models        Model3D[]
}

model Model3D {
  id            String    @id @default(uuid())
  title         String
  description   String
  fileUrl       String    // Caminho do STL na nuvem
  gcodeStream   Boolean   @default(true) // Se obriga streaming de G-code sem download
  royaltyPrice  Float     // Valor fixo de royalty por impressão
  designerId    String
  designer      DesignerProfile @relation(fields: [designerId], references: [id], onDelete: Cascade)
  
  orders        Order[]
}

model Order {
  id            String    @id @default(uuid())
  status        String    // "WAITING_MAKER" | "PRINTING" | "SHIPPED" | "COMPLETED" | ...
  totalPrice    Float
  makerPrice    Float
  royaltyPaid   Float
  platformFee   Float
  filename      String?   // STL/3MF da peça (seed) — não confundir com Model3D
  
  // Geolocalização e entrega
  shippingZip   String
  shippingAddress String
  
  clientId      String
  client        User      @relation("ClientOrders", fields: [clientId], references: [id])
  
  makerId       String?
  maker         MakerProfile? @relation("MakerOrders", fields: [makerId], references: [id])
  
  modelId       String?
  model         Model3D?      @relation(fields: [modelId], references: [id])

  /** Catálogo curado (D006) — id estável tipo fm-cable-clip; sem FK */
  catalogId     String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PrinterModel {
  id                String   @id @default(uuid())
  brand             String   // Fabricante (ex: "Bambu Lab")
  modelName         String   // Modelo (ex: "P1S")
  technology        String   // Tecnologia (ex: "FDM", "SLA", "SLS")
  volumeX           Float    // Volume útil X em mm
  volumeY           Float    // Volume útil Y em mm
  volumeZ           Float    // Volume útil Z em mm
  hasEnclosure      Boolean  // Câmara fechada (Sim/Não)
  hasMulticolor     Boolean  // Suporte a cores/AMS/MMU
  maxNozzleTemp     Int      // Temperatura máxima do bico (°C)
  maxBedTemp        Int      // Temperatura máxima da mesa (°C)
  compatibleMaterials String // Lista de materiais compatíveis serializados (ex: "PLA,PETG,ABS,ASA,TPU")
  supportedNozzles  String   // Diâmetros de bicos suportados (ex: "0.2,0.4,0.6,0.8")
  typicalPrecision  Float    // Precisão típica em mm (ex: 0.05)
  maxSpeed          Int      // Velocidade máxima em mm/s (ex: 500)
  maxPartWeightG    Float    // Peso máximo recomendado da peça em gramas (ex: 3000)
  releaseYear       Int      // Ano de lançamento (ex: 2023)
  status            String   // Status (ex: "ACTIVE", "DISCONTINUED")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
